{
  "name": "@quiz-mcp/ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./dist/lib/i18n.d.ts",
      "import": "./dist/lib/i18n.js"
    },
    "./i18n-svelte": {
      "types": "./dist/lib/i18n-svelte.d.ts",
      "svelte": "./src/lib/i18n-svelte.ts",
      "import": "./dist/lib/i18n-svelte.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo 'lint ok'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf --glob dist *.tsbuildinfo"
  },
  "dependencies": {
    "@quiz-mcp/core": "workspace:*",
    "@viz-js/viz": "^3.31.0",
    "daisyui": "^5",
    "dompurify": "^3.4.16",
    "highlight.js": "^11",
    "katex": "^0.16.47",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^12.1.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "svelte": "^5",
    "typescript": "^5.8",
    "vitest": "^2"
  }
}
